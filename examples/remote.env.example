# Local repositories the supervisor may access. Separate Windows roots with semicolons.
CODEX_ALLOWED_ROOTS=C:\Users\Red Mex\Documents\codex-supervisor-mcp

# Existing native Codex executable used by the supervisor. Prefer codex.exe, not the npm .ps1 shim.
# CODEX_BIN=C:\Users\YOU\AppData\Roaming\npm\node_modules\@openai\codex\node_modules\@openai\codex-win32-x64\vendor\x86_64-pc-windows-msvc\bin\codex.exe

CODEX_ALLOW_NETWORK=0
CODEX_SUPERVISOR_MCP_NAME=codex-supervisor

CODEX_REMOTE_HOST=127.0.0.1
CODEX_REMOTE_PORT=8787
CODEX_REMOTE_PATH=/mcp
CODEX_REMOTE_RATE_LIMIT_PER_MINUTE=60
CODEX_REMOTE_TOOL_TIMEOUT_MS=900000

# bearer: easiest for Responses API clients.
# oauth: recommended for a ChatGPT custom MCP connector.
# none: loopback testing only.
CODEX_REMOTE_AUTH_MODE=bearer
# Omit this in local .env to let scripts/start-remote.ps1 create .remote-bearer-token.
# CODEX_REMOTE_BEARER_TOKEN=replace-with-at-least-32-random-bytes

# OAuth mode only:
# CODEX_REMOTE_OAUTH_ISSUER=https://YOUR_TENANT.us.auth0.com
# CODEX_REMOTE_OAUTH_AUDIENCE=https://codex-supervisor.example/mcp
# CODEX_REMOTE_PUBLIC_URL=https://codex-supervisor.example
